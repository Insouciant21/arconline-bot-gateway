PORT=8787
HOST=0.0.0.0
# Public HTTPS origin of this gateway (used for QQ Webhook media URL uploads)
PUBLIC_BASE_URL=https://bot-gw.example.com
# Bearer secret for /admin/* endpoints
ADMIN_SECRET=replace-with-a-long-random-admin-secret
# Master key for encrypting Bot clientSecret & instance bridgeSecret in SQLite
MASTER_KEY=replace-with-a-long-random-master-key
# HMAC secret for short-lived /qq/media/:token proxy URLs (falls back to MASTER_KEY if unset)
MEDIA_SIGNING_KEY=
# SQLite database path
DB_PATH=./data/gateway.db
# Sync polling limits for /b50
SYNC_POLL_INTERVAL_MS=1500
SYNC_POLL_TIMEOUT_MS=45000
