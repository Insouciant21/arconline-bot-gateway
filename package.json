{
  "name": "arconline-qq-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "dev:web": "astro dev --root web",
    "build:web": "astro build --root web",
    "build": "pnpm run build:web && tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "astro check --root web && tsc -p tsconfig.json --noEmit",
    "pretest": "pnpm run build:web",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
